{
  "dependencies": {
    "axios": "^1.9.0",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "mongoose": "^8.15.0",
    "nodemailer": "^7.0.3",
    "nodemon": "^3.1.10",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0",
    "concurrently": "^9.1.2"
  },
  "scripts": {
    "start:user":    "node UserService/server.js",
    "start:product": "node ProductService/server.js",
    "start:order":   "node OrderService/server.js",
    "start": "concurrently \"npm run start:user\" \"npm run start:product\" \"npm run start:order\"",
    "dev:user":    "nodemon UserService/server.js",
    "dev:product": "nodemon ProductService/server.js",
    "dev:order":   "nodemon OrderService/server.js",
    "dev": "concurrently \"npm run dev:user\" \"npm run dev:product\" \"npm run dev:order\""
  }
}
